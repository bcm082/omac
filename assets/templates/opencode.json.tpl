{
  "$schema": "https://opencode.ai/theme.json",
  "theme": {
    "primary": "{{ accent }}",
    "secondary": "{{ magenta }}",
    "accent": "{{ cyan }}",
    "error": "{{ red }}",
    "warning": "{{ yellow }}",
    "success": "{{ green }}",
    "info": "{{ blue }}",
    "text": "{{ foreground }}",
    "textMuted": "{{ dark_foreground }}",
    "background": "{{ background }}",
    "backgroundPanel": "{{ dark_background }}",
    "backgroundElement": "{{ lighter_background }}",
    "border": "{{ muted }}",
    "borderActive": "{{ accent }}",
    "borderSubtle": "{{ lighter_background }}",
    "diffAdded": "{{ green }}",
    "diffRemoved": "{{ red }}",
    "diffContext": "{{ dark_foreground }}",
    "diffHunkHeader": "{{ blue }}",
    "diffHighlightAdded": "{{ bright_green }}",
    "diffHighlightRemoved": "{{ bright_red }}",
    "diffAddedBg": "{{ mix background green 12% }}",
    "diffRemovedBg": "{{ mix background red 12% }}",
    "diffContextBg": "{{ dark_background }}",
    "diffLineNumber": "{{ muted }}",
    "diffAddedLineNumberBg": "{{ mix background green 8% }}",
    "diffRemovedLineNumberBg": "{{ mix background red 8% }}",
    "markdownText": "{{ foreground }}",
    "markdownHeading": "{{ accent }}",
    "markdownLink": "{{ blue }}",
    "markdownLinkText": "{{ cyan }}",
    "markdownCode": "{{ green }}",
    "markdownBlockQuote": "{{ dark_foreground }}",
    "markdownEmph": "{{ yellow }}",
    "markdownStrong": "{{ orange }}",
    "markdownHorizontalRule": "{{ muted }}",
    "markdownListItem": "{{ accent }}",
    "markdownListEnumeration": "{{ cyan }}",
    "markdownImage": "{{ blue }}",
    "markdownImageText": "{{ cyan }}",
    "markdownCodeBlock": "{{ foreground }}",
    "syntaxComment": "{{ dark_foreground }}",
    "syntaxKeyword": "{{ magenta }}",
    "syntaxFunction": "{{ blue }}",
    "syntaxVariable": "{{ foreground }}",
    "syntaxString": "{{ green }}",
    "syntaxNumber": "{{ orange }}",
    "syntaxType": "{{ yellow }}",
    "syntaxOperator": "{{ cyan }}",
    "syntaxPunctuation": "{{ foreground }}"
  }
}
