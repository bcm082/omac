{
  "document": { "block_prefix": "\n", "block_suffix": "\n", "color": "{{ foreground }}", "margin": 2 },
  "block_quote": { "indent": 1, "indent_token": "│ ", "color": "{{ dark_foreground }}", "italic": true },
  "paragraph": {},
  "list": { "level_indent": 2 },
  "heading": { "block_suffix": "\n", "color": "{{ accent }}", "bold": true },
  "h1": { "prefix": " ", "suffix": " ", "color": "{{ background }}", "background_color": "{{ accent }}", "bold": true },
  "h2": { "prefix": "## " },
  "h3": { "prefix": "### " },
  "h4": { "prefix": "#### " },
  "h5": { "prefix": "##### " },
  "h6": { "prefix": "###### ", "bold": false },
  "text": {},
  "strikethrough": { "crossed_out": true },
  "emph": { "italic": true, "color": "{{ yellow }}" },
  "strong": { "bold": true, "color": "{{ orange }}" },
  "hr": { "color": "{{ muted }}", "format": "\n--------\n" },
  "item": { "block_prefix": "• " },
  "enumeration": { "block_prefix": ". " },
  "task": { "ticked": "[✓] ", "unticked": "[ ] " },
  "link": { "color": "{{ blue }}", "underline": true },
  "link_text": { "color": "{{ cyan }}", "bold": true },
  "image": { "color": "{{ magenta }}", "underline": true },
  "image_text": { "color": "{{ dark_foreground }}", "format": "Image: {{.text}} →" },
  "code": { "prefix": " ", "suffix": " ", "color": "{{ red }}", "background_color": "{{ lighter_background }}" },
  "code_block": {
    "color": "{{ foreground }}",
    "margin": 2,
    "chroma": {
      "text": { "color": "{{ foreground }}" },
      "error": { "color": "{{ red }}" },
      "comment": { "color": "{{ dark_foreground }}" },
      "comment_preproc": { "color": "{{ cyan }}" },
      "keyword": { "color": "{{ magenta }}" },
      "keyword_reserved": { "color": "{{ magenta }}" },
      "keyword_namespace": { "color": "{{ magenta }}" },
      "keyword_type": { "color": "{{ yellow }}" },
      "operator": { "color": "{{ cyan }}" },
      "punctuation": { "color": "{{ foreground }}" },
      "name": { "color": "{{ foreground }}" },
      "name_builtin": { "color": "{{ blue }}" },
      "name_tag": { "color": "{{ red }}" },
      "name_attribute": { "color": "{{ yellow }}" },
      "name_class": { "color": "{{ yellow }}", "bold": true },
      "name_constant": { "color": "{{ orange }}" },
      "name_decorator": { "color": "{{ yellow }}" },
      "name_function": { "color": "{{ blue }}" },
      "literal_number": { "color": "{{ orange }}" },
      "literal_string": { "color": "{{ green }}" },
      "literal_string_escape": { "color": "{{ cyan }}" },
      "generic_deleted": { "color": "{{ red }}" },
      "generic_emph": { "italic": true },
      "generic_inserted": { "color": "{{ green }}" },
      "generic_strong": { "bold": true },
      "generic_subheading": { "color": "{{ dark_foreground }}" },
      "background": { "background_color": "{{ lighter_background }}" }
    }
  },
  "table": {},
  "definition_list": {},
  "definition_term": {},
  "definition_description": { "block_prefix": "\n🠶 " },
  "html_block": {},
  "html_span": {}
}
